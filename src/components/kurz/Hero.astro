---
import { Image } from 'astro:assets';
import Badge from '../ui/Badge.astro';
import Title from '../ui/Title.astro';
import Text from '../ui/Text.astro';
import Button from '../ui/Button.astro';
import Field from '../ui/Field.astro';
import Icon from '../ui/Icon.astro';
import { hero, form } from '../../data/content/kurz';
import { images } from '../../data/images';
import { site } from '../../data/site';
---
<section class="wrap full" id="region-check" style="background: var(--color-kit-dark); --accent: var(--color-kit-key1);">
  <div class="glow" aria-hidden="true"></div>
  <div class="container">
    <div class="brand">
      <Image class="logo" src={images.logoHell.src} alt={images.logoHell.alt} height={40} widths={[160, 320, 480]} sizes="160px" loading="eager" fetchpriority="high" />
    </div>

    <div class="stack" data-reveal data-reveal-load style="--ry: 26px;">
      <Badge variant="gold" dot>{hero.badge}</Badge>
      <Title as="h1" size="xl" align="center" color="var(--color-kit-white)" class="h1">
        {hero.headline} <span class="accent">{hero.headlineAccent}</span>
      </Title>
      <Text size="xl" align="center" color="#ffffffbf" class="sub">{hero.subline}</Text>
    </div>

    <div class="card" data-form-card data-reveal data-reveal-load style="--ry: 26px; --rdelay: 0.14s;">
      <div class="cardEdge" aria-hidden="true"></div>
      <div class="cardBody">
        <h2 class="cardH" data-step-title data-t1={form.title} data-t2={form.step2Title}>{form.title}</h2>
        <form
          class="form"
          action="/api/anfrage"
          method="post"
          novalidate
          data-region-form
          data-redirect={form.redirectUrl}
          data-err-required={form.errRequired}
          data-err-email={form.errEmail}
          data-err-submit={form.errSubmit}
          data-phone-hint={`Oder rufen Sie uns an: ${site.contact.phone}`}
        >
          <input type="hidden" name="quelle" value="/kurz" />
          <div class="hp-field" aria-hidden="true">
            <label for="sq-website">Bitte leer lassen</label>
            <input id="sq-website" type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="stepBox" data-step="1">
            <div class="inline">
              <Field id="sq-region" name="region" label={form.regionLabel} placeholder={form.regionPlaceholder} required autocomplete="postal-code" />
              <Button variant="gold" size="lg" icon="arrowRight" class="inlineBtn" data-next>{form.step1Cta}</Button>
            </div>
            <span class="fine">{form.reassurance}</span>
          </div>

          <div class="stepBox" data-step="2">
            <div class="row2">
              <Field id="sq-name" name="name" label={form.labelName} required autocomplete="name" />
              <Field id="sq-company" name="unternehmen" label={form.labelCompany} required autocomplete="organization" />
            </div>
            <div class="row2">
              <Field id="sq-phone" name="telefon" type="tel" label={form.labelPhone} required autocomplete="tel" inputmode="tel" />
              <Field id="sq-email" name="email" type="email" label={form.labelEmail} required autocomplete="email" inputmode="email" />
            </div>
            <Button type="submit" variant="gold" size="lg" full icon="arrowRight" data-submit>{form.submitLabel}</Button>
            <span class="errLine" data-err-line role="alert"></span>
            <span class="fine">
              {form.privacyNote}{' '}
              <a class="privacyLink tap" href={site.legal.datenschutz}>{form.privacyLinkLabel}</a>
            </span>
            <button class="back" type="button" data-back>{form.backLabel}</button>
          </div>
        </form>
      </div>
    </div>

    <div class="person" data-reveal data-reveal-load style="--ry: 14px; --rdur: 0.55s; --rdelay: 0.26s;">
      <Image class="avatar" src={images.simon.src} alt={images.simon.alt} width={54} height={54} widths={[54, 108, 162]} sizes="54px" fit="cover" />
      <span class="personBody">
        <span class="personQuote">{hero.personQuote}</span>
        <span class="personMeta">
          <span class="personName">{site.person.name}</span>
          <span class="personRole">{hero.personRole}</span>
        </span>
      </span>
    </div>

    <ul class="trust" data-reveal="fade" data-reveal-load style="--rdelay: 0.38s;">
      {hero.trust.map((t) => (
        <li class="trustItem"><Icon name="check" size={14} strokeWidth={3} /><span>{t}</span></li>
      ))}
    </ul>
  </div>
</section>

<script>
  import '../../scripts/region-form';
</script>

<style>
  .wrap { position: relative; overflow: hidden; padding: clamp(34px, 5vw, 60px) 0 clamp(44px, 6vw, 74px); font-family: var(--font-text); }
  .full { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; }
  .glow {
    position: absolute;
    left: 50%; top: -26%;
    width: 1100px; height: 800px;
    transform: translateX(-50%);
    pointer-events: none;
    background: radial-gradient(closest-side, #C6A15B33 0%, #C6A15B00 100%);
  }
  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .brand { display: inline-flex; margin-bottom: clamp(28px, 4vw, 46px); }
  .brand :global(.logo) { display: block; height: 40px; width: auto; }
  .stack { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .stack :global(.h1) { max-width: 13em; }
  .accent { color: var(--accent, #C6A15B); }
  .stack :global(.sub) { max-width: 26em; }
  .card {
    position: relative;
    width: 100%;
    margin-top: clamp(28px, 4vw, 40px);
    background: var(--color-kit-white);
    border-radius: 6px;
    box-shadow: 0 40px 90px -40px #000000a6;
    overflow: hidden;
  }
  .cardEdge { height: 4px; width: 100%; background: linear-gradient(90deg, var(--accent, #C6A15B) 0%, #e2c894 52%, var(--accent, #C6A15B) 100%); }
  .cardBody { padding: clamp(22px, 3vw, 30px); display: flex; flex-direction: column; gap: 14px; }
  .cardH {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--color-kit-black);
    text-align: center;
  }
  .form, .stepBox { display: flex; flex-direction: column; gap: 13px; }
  .stepBox[hidden] { display: none; }
  .inline { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: end; }
  .inline :global(.inlineBtn) { white-space: nowrap; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 11px; }
  .fine { font-size: 12.5px; color: #1D3E5699; text-align: center; line-height: 1.5; }
  .privacyLink { color: #8a6c2f; text-decoration: underline; text-underline-offset: 2px; }
  .errLine { font-size: 12.5px; color: #b0402f; font-weight: 500; text-align: center; }
  .errLine:empty { display: none; }
  .back {
    background: none;
    border: none;
    font-family: inherit;
    font-size: 13.5px;
    color: #1D3E5699;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 4px;
    align-self: center;
    min-height: 44px;
    min-width: 44px;
    margin: -10px 0;
  }
  .form:not(.is-enhanced) .back { display: none; }
  .person {
    display: flex;
    align-items: center;
    gap: 15px;
    width: 100%;
    margin-top: clamp(20px, 2.6vw, 28px);
    padding: 15px 20px 15px 15px;
    background: #ffffff0a;
    border: 1px solid #ffffff1f;
    border-radius: 6px;
  }
  .person :global(.avatar) {
    width: 54px;
    height: 54px;
    border-radius: 999px;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--accent, #C6A15B);
  }
  .personBody { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .personQuote { font-size: 14.5px; line-height: 1.45; color: #ffffffdb; }
  .personMeta { display: flex; flex-wrap: wrap; gap: 4px 8px; font-size: 12.5px; line-height: 1.3; }
  .personName { font-weight: 600; color: #ffffffbf; }
  .personRole { color: #ffffff80; }
  .trust {
    list-style: none;
    margin: clamp(26px, 3.4vw, 38px) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 26px;
  }
  .trustItem { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; color: #ffffff9e; letter-spacing: 0.01em; }
  .trustItem :global(svg) { color: var(--accent, #C6A15B); }
  @media (max-width: 560px) {
    .inline { grid-template-columns: 1fr; }
    .inline :global(.inlineBtn) { width: 100%; }
    .row2 { grid-template-columns: 1fr; }
    .trust { gap: 10px 18px; }
  }
</style>
