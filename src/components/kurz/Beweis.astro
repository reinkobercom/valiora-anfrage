---
import Button from '../ui/Button.astro';
import { beweis as c } from '../../data/content/kurz';
import { site } from '../../data/site';
---
<section class="wrap" style="background: var(--color-kit-light); --accent: var(--color-kit-key1);">
  <div class="container">
    <div class="proof" data-reveal data-amount="0.4" style="--ry: 20px; --rdur: 0.55s;">
      <span class="proofValue">{c.proofValue}</span>
      <span class="proofBody">
        <span class="proofText">{c.proofText}</span>
        <span class="proofSource">{c.proofSource}</span>
      </span>
    </div>

    <div class="block" data-reveal data-amount="0.3" style="--ry: 20px; --rdur: 0.55s; --rdelay: 0.1s;">
      <h2 class="itemsTitle">{c.itemsTitle}</h2>
      <ul class="items">
        {c.items.map((it) => (
          <li class="item">
            <span class="itemTitle">{it.title}</span>
            <span class="itemText">{it.text}</span>
          </li>
        ))}
      </ul>
      <p class="closer">{c.closer}</p>
    </div>

    <div class="ctaBox" data-reveal data-amount="0.5" style="--ry: 18px; --rdur: 0.5s; --rdelay: 0.16s;">
      <Button href="#region-check" variant="gold" size="lg" icon="arrowDown">{c.ctaLabel}</Button>
      <span class="ctaNote">{c.ctaNote}</span>
    </div>

    <footer class="footer">
      <span class="fName">{site.name}</span>
      <nav class="fLinks" aria-label="Rechtliches">
        <a class="fLink tap" href={site.legal.impressum}>Impressum</a>
        <a class="fLink tap" href={site.legal.datenschutz}>Datenschutz</a>
        <a class="fLink tap" href="#cookie-einstellungen" data-cookie-settings>Cookie-Einstellungen</a>
      </nav>
      <span class="copy">{site.copyright}</span>
    </footer>
  </div>
</section>

<style>
  .wrap { position: relative; padding: clamp(48px, 6vw, 82px) 0 clamp(28px, 3.5vw, 40px); font-family: var(--font-text); }
  .container { max-width: 760px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 32px); }
  .proof {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: clamp(20px, 2.6vw, 28px);
    background: var(--color-kit-key2);
    border-left: 4px solid var(--accent, #C6A15B);
    border-radius: 4px;
    box-shadow: 0 26px 60px -40px #1D3E56cc;
  }
  .proofValue {
    font-family: var(--font-head);
    font-size: clamp(48px, 7vw, 68px);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.045em;
    color: var(--accent, #C6A15B);
    flex-shrink: 0;
  }
  .proofBody { display: flex; flex-direction: column; gap: 5px; }
  .proofText { font-family: var(--font-head); font-size: clamp(16px, 1.9vw, 19px); font-weight: 700; line-height: 1.3; letter-spacing: -0.012em; color: #ffffff; }
  .proofSource { font-size: 13px; color: #ffffff9e; }
  .block { margin-top: clamp(34px, 4.5vw, 54px); }
  .itemsTitle {
    display: block;
    margin: 0 0 20px;
    font-family: var(--font-text);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a6c2f;
  }
  .items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .item {
    display: grid;
    grid-template-columns: 152px minmax(0, 1fr);
    gap: 16px;
    padding: 17px 0;
    border-top: 1px solid #1D3E561f;
    align-items: baseline;
  }
  .item:last-child { border-bottom: 1px solid #1D3E561f; }
  .itemTitle { font-family: var(--font-head); font-size: clamp(16px, 1.8vw, 18px); font-weight: 700; letter-spacing: -0.012em; color: var(--color-kit-black); }
  .itemText { font-size: 15.5px; line-height: 1.55; color: #1D3E56ad; }
  .closer {
    margin: 22px 0 0;
    font-family: var(--font-head);
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.012em;
    color: var(--color-kit-black);
  }
  .ctaBox { display: flex; flex-direction: column; align-items: center; gap: 11px; margin-top: clamp(32px, 4vw, 46px); }
  .ctaNote { font-size: 12.5px; color: #1D3E5699; text-align: center; }
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 22px;
    margin-top: clamp(40px, 5vw, 62px);
    padding-top: 22px;
    border-top: 1px solid #1D3E5617;
  }
  .fName { font-family: var(--font-head); font-size: 14px; font-weight: 800; letter-spacing: 0.18em; color: var(--color-kit-key2); }
  .fLinks { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .fLink {
    font-size: 13px;
    color: #1D3E5699;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .fLink:hover { color: var(--color-kit-key2); border-color: var(--accent, #C6A15B); }
  .copy { font-size: 12px; color: #1D3E5673; }
  @media (max-width: 560px) {
    .proof { gap: 16px; }
    .item { grid-template-columns: 1fr; gap: 5px; }
    .footer { justify-content: flex-start; }
  }
</style>
