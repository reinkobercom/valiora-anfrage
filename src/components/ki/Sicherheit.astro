---
import SectionHead from '../ui/SectionHead.astro';
import IconCard from '../ui/IconCard.astro';
import { sicherheit as c } from '../../data/content/kiRegioSystem';
---
<section class="root" style="background: var(--color-kit-light);">
  <div class="container">
    <div class="head">
      <SectionHead kicker={c.kicker} title={c.titleStart} accent={c.titleAccent} titleEnd={c.titleEnd} subline={c.subline} align="center" tone="dark" />
    </div>

    <ul class="grid">
      {c.items.map((it, i) => (
        <li class="cell" data-reveal data-amount="0.25" style={`--ry: 22px; --rdur: 0.5s; --rdelay: ${(i * 0.09).toFixed(2)}s;`}>
          <IconCard icon={it.icon} title={it.title} text={it.text} tone="dark" />
        </li>
      ))}
    </ul>

    <p class="note">{c.note}</p>
  </div>
</section>

<style>
  .root { padding: clamp(84px, 9vw, 148px) 20px; font-family: var(--font-text); }
  .container { max-width: 1180px; margin: 0 auto; width: 100%; }
  .head { margin-bottom: clamp(56px, 6.2vw, 92px); }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(22px, 2.6vw, 34px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cell {
    background: #ffffff;
    border: 1px solid #0B1A2612;
    border-radius: 8px;
    padding: clamp(28px, 3vw, 40px);
    height: 100%;
  }
  .note { margin: clamp(34px, 4vw, 52px) 0 0; text-align: center; font-size: 12.5px; color: #0B1A268a; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
