---
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';
import { system as c } from '../../data/content/kiRegioSystem';
---
<section class="root" style="background: var(--color-kit-light); --accent: var(--color-kit-key1);">
  <div class="container">
    <div class="head">
      <SectionHead kicker={c.kicker} title={c.titleStart} accent={c.titleAccent} titleEnd={c.titleEnd} subline={c.subline} align="center" tone="dark" />
    </div>

    <div class="diagram" data-reveal data-amount="0.3" style="--ry: 20px; --rdur: 0.6s;">
      <div class="node">
        <span class="tile"><Icon name="mapPin" size={34} strokeWidth={1.6} /></span>
        <div>
          <p class="nodeLabel">{c.leftLabel}</p>
          <p class="nodeCaption">{c.leftCaption}</p>
        </div>
      </div>

      <div class="linkWrap" aria-hidden="true">
        <span class="link"><span class="linkDot" style="left: 22%;"></span></span>
      </div>

      <div class="node">
        <div class="core">
          <span class="coreRing" aria-hidden="true"></span>
          <p class="coreLabel">{c.centerLabel}</p>
          <p class="coreCaption">{c.centerCaption}</p>
        </div>
      </div>

      <div class="linkWrap" aria-hidden="true">
        <span class="link"><span class="linkDot" style="left: 68%;"></span></span>
      </div>

      <div class="node">
        <span class="tile"><Icon name="users" size={34} strokeWidth={1.6} /></span>
        <div>
          <p class="nodeLabel">{c.rightLabel}</p>
          <p class="nodeCaption">{c.rightCaption}</p>
        </div>
      </div>
    </div>

    <p class="footnote">{c.footnote}</p>
  </div>
</section>

<style>
  .root {
    position: relative;
    overflow: hidden;
    padding: clamp(84px, 9vw, 148px) 20px;
    font-family: var(--font-text);
  }
  .container { max-width: 1250px; margin: 0 auto; width: 100%; }
  .head { margin-bottom: clamp(64px, 7vw, 108px); }
  .diagram {
    display: grid;
    grid-template-columns: 1fr minmax(24px, 1fr) auto minmax(24px, 1fr) 1fr;
    align-items: center;
    gap: clamp(16px, 3vw, 44px);
    max-width: 980px;
    margin: 0 auto;
  }
  .node { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
  .tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(84px, 9vw, 116px);
    height: clamp(84px, 9vw, 116px);
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid #1D3E5617;
    box-shadow: 0 22px 44px -34px #1D3E5673;
    color: var(--color-kit-key2);
  }
  .core {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: clamp(150px, 17vw, 212px);
    min-height: clamp(112px, 12vw, 148px);
    padding: 18px 16px;
    border-radius: 12px;
    background: var(--color-kit-black);
    text-align: center;
  }
  .coreRing {
    position: absolute;
    inset: -7px;
    border-radius: 16px;
    border: 1px solid #C6A15B4d;
    pointer-events: none;
  }
  .coreLabel {
    font-family: var(--font-head);
    font-size: clamp(15px, 1.6vw, 18px);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: #ffffff;
    margin: 0;
  }
  .coreCaption {
    margin: 0;
    font-size: 11.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--accent);
  }
  .nodeLabel {
    font-family: var(--font-head);
    font-size: clamp(15px, 1.5vw, 17px);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-kit-black);
    margin: 0;
  }
  .nodeCaption { margin: 6px 0 0; font-size: 13.5px; line-height: 1.5; color: #0B1A26a1; }
  .link { position: relative; height: 1px; width: 100%; background: #1D3E5629; }
  .linkDot {
    position: absolute;
    top: -3px;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
  }
  .linkWrap { display: flex; align-items: center; padding: 0 4px; align-self: center; width: 100%; }
  .footnote {
    margin: clamp(52px, 6vw, 84px) auto 0;
    text-align: center;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: #0B1A2699;
    padding-top: 26px;
    border-top: 1px solid #0B1A2614;
    max-width: 560px;
  }
  @media (max-width: 860px) {
    .diagram { grid-template-columns: 1fr; gap: 26px; max-width: 380px; }
    .linkWrap { justify-content: center; height: 42px; }
    .link { width: 1px; height: 100%; }
    .linkDot { top: auto; left: -3px; }
  }
</style>
