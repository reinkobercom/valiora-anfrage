---
import Badge from '../ui/Badge.astro';
import Title from '../ui/Title.astro';
import Text from '../ui/Text.astro';
import CheckItem from '../ui/CheckItem.astro';
import { hero as c } from '../../data/content/kiRegioSystem';
---
<section class="root" style="background: var(--color-kit-black); --accent: var(--color-kit-key1);">
  <div class="container">
    <div class="grid">
      <div class="left">
        <div class="lockup" data-reveal data-amount="0.25" style="--ry: 22px; --rdur: 0.5s;">
          <span class="lockupRule"></span>
          <span class="lockupName">{c.systemName}</span>
        </div>

        <div class="badgeRow" data-reveal data-amount="0.25" style="--ry: 22px; --rdur: 0.5s; --rdelay: 0.08s;">
          <Badge variant="gold" dot>{c.badge}</Badge>
        </div>

        <div class="headline" data-reveal data-amount="0.25" style="--ry: 22px; --rdur: 0.55s; --rdelay: 0.16s;">
          <Title as="h1" size="xl" color="#FFFFFF">
            {c.headlineStart}<span class="accent">{c.headlineAccent}</span>{c.headlineEnd}
          </Title>
        </div>

        <div class="subline" data-reveal data-amount="0.25" style="--ry: 22px; --rdur: 0.55s; --rdelay: 0.24s;">
          <Text size="lg" color="#FFFFFFB8">{c.subline}</Text>
        </div>

        <ul class="bullets" data-reveal data-amount="0.25" style="--ry: 22px; --rdur: 0.55s; --rdelay: 0.32s;">
          {c.bullets.map((b) => <CheckItem tone="light" size="lg">{b}</CheckItem>)}
        </ul>

        <ul class="tags" data-reveal data-amount="0.25" style="--ry: 22px; --rdur: 0.55s; --rdelay: 0.4s;">
          {c.tags.map((t) => <li class="tag">{t}</li>)}
        </ul>
      </div>

      <div class="right" data-reveal data-amount="0.2" style="--ry: 26px; --rdur: 0.6s; --rdelay: 0.18s;">
        <div class="cover">
          <span class="coverBar" aria-hidden="true"></span>
          <span class="coverLabel">{c.coverLabel}</span>
          <p class="coverTitle">{c.coverTitle}</p>
          <dl class="rows">
            {c.coverRows.map((r) => (
              <div class="row">
                <dt class="rowLabel">{r.label}</dt>
                <dd class="rowValue">{r.value}</dd>
              </div>
            ))}
          </dl>
          <p class="note">{c.coverNote}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .root {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(54px, 6.6vw, 104px) 20px clamp(62px, 7.4vw, 112px);
    font-family: var(--font-text);
  }
  .root::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(72% 58% at 8% 4%, #C6A15B1c 0%, #C6A15B00 62%),
      linear-gradient(158deg, #0B1A2600 0%, #1D3E5652 58%, #16324766 100%);
  }
  .root::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: repeating-linear-gradient(90deg, #ffffff09 0px, #ffffff09 1px, #ffffff00 1px, #ffffff00 104px);
    mask-image: linear-gradient(180deg, #000000 0%, #00000000 88%);
    -webkit-mask-image: linear-gradient(180deg, #000000 0%, #00000000 88%);
  }
  .container { position: relative; max-width: 1250px; margin: 0 auto; width: 100%; }
  .grid {
    display: grid;
    grid-template-columns: 1.06fr 0.84fr;
    gap: clamp(38px, 4.6vw, 78px);
    align-items: start;
  }
  .left { min-width: 0; }
  .lockup { display: flex; align-items: center; gap: 14px; margin-bottom: 26px; }
  .lockupRule { display: block; width: 40px; height: 2px; border-radius: 2px; flex-shrink: 0; background: var(--accent); }
  .lockupName {
    font-family: var(--font-head);
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--accent);
  }
  .badgeRow { margin-bottom: 22px; }
  .headline { margin-bottom: 22px; }
  .accent { font-style: normal; color: var(--accent); }
  .subline { max-width: 56ch; margin-bottom: 34px; }
  .bullets {
    list-style: none;
    margin: 0 0 34px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
    max-width: 58ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    padding-top: 28px;
    border-top: 1px solid #ffffff1a;
    list-style: none;
    margin: 0;
    padding-left: 0;
  }
  .tag {
    display: inline-block;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid #ffffff26;
    background: #ffffff08;
    color: #ffffffb0;
    font-size: 12.5px;
    letter-spacing: 0.02em;
    line-height: 1.2;
    white-space: nowrap;
  }
  .right { min-width: 0; }
  .cover {
    position: relative;
    border: 1px solid #ffffff1f;
    background: #ffffff0a;
    border-radius: 8px;
    padding: clamp(24px, 2.6vw, 36px);
  }
  .coverBar {
    position: absolute;
    top: -1px;
    left: -1px;
    width: 68px;
    height: 3px;
    border-radius: 8px 0 4px 0;
    background: var(--accent);
  }
  .coverLabel {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    margin-bottom: 12px;
    color: var(--accent);
  }
  .coverTitle {
    font-family: var(--font-head);
    font-size: clamp(18px, 1.8vw, 21px);
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: -0.012em;
    color: #ffffff;
    margin: 0 0 26px;
  }
  .rows { margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: 78px 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 13px 0;
    border-top: 1px solid #ffffff17;
  }
  .rowLabel {
    margin: 0;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #ffffff70;
    line-height: 1.5;
  }
  .rowValue { margin: 0; font-size: 14.5px; line-height: 1.5; color: #ffffffdb; }
  .note {
    margin: 24px 0 0;
    padding-top: 18px;
    border-top: 1px solid #ffffff17;
    font-size: 12.5px;
    line-height: 1.6;
    color: #ffffff8a;
  }
  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; gap: 42px; }
    .subline, .bullets { max-width: none; }
  }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; gap: 5px; }
    .tag { white-space: normal; }
  }
</style>
