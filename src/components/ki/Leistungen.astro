---
import SectionHead from '../ui/SectionHead.astro';
import { leistungen as c } from '../../data/content/kiRegioSystem';
---
<section class="root" style="background: var(--color-kit-black);">
  <div class="container">
    <div class="head">
      <SectionHead kicker={c.kicker} title={c.titleStart} accent={c.titleAccent} titleEnd={c.titleEnd} align="center" tone="light" />
    </div>

    <div class="body">
      {c.paragraphs.map((p, i) => (
        <p class="para" data-reveal data-amount="0.4" style={`--ry: 18px; --rdur: 0.55s; --rdelay: ${(i * 0.08).toFixed(2)}s;`}>{p}</p>
      ))}
    </div>

    <p class="closing">{c.closing}</p>
  </div>
</section>

<style>
  .root {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(88px, 9.4vw, 156px) 20px;
    font-family: var(--font-text);
  }
  .root::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(58% 46% at 50% 0%, #1D3E5666 0%, #1D3E5600 70%);
  }
  .container { max-width: 820px; margin: 0 auto; width: 100%; }
  .head { margin-bottom: clamp(48px, 5.4vw, 76px); }
  .body { display: flex; flex-direction: column; gap: clamp(26px, 2.8vw, 38px); }
  .para {
    margin: 0;
    text-align: center;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.78;
    color: #ffffffc4;
  }
  .closing {
    margin: clamp(48px, 5.4vw, 76px) auto 0;
    max-width: 620px;
    text-align: center;
    padding-top: 30px;
    border-top: 1px solid #ffffff1f;
    font-size: 14px;
    line-height: 1.66;
    color: #ffffff87;
  }
</style>
