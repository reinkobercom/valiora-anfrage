---
import SectionHead from '../ui/SectionHead.astro';
import CheckItem from '../ui/CheckItem.astro';
import { terminkriterien as c } from '../../data/content/kiRegioSystem';
---
<section class="root" style="background: var(--color-kit-light); --accent: var(--color-kit-key1);">
  <div class="container">
    <div class="grid">
      <div>
        <div class="head">
          <SectionHead kicker={c.kicker} title={c.titleStart} accent={c.titleAccent} titleEnd={c.titleEnd} align="left" tone="dark" />
        </div>
        <p class="intro">{c.intro}</p>
        <p class="outro">{c.outro}</p>
      </div>

      <div data-reveal data-amount="0.22" style="--ry: 26px; --rdur: 0.6s;">
        <div class="panel">
          <h3 class="panelTitle">{c.criteriaTitle}</h3>
          <ul class="list">
            {c.criteria.map((t) => <CheckItem tone="dark" size="md">{t}</CheckItem>)}
          </ul>
          <p class="panelNote">{c.criteriaNote}</p>
        </div>

        <div class="own">
          <h3 class="ownTitle">{c.ownTitle}</h3>
          <ul class="list">
            {c.ownItems.map((t) => <CheckItem tone="plain" size="sm">{t}</CheckItem>)}
          </ul>
          <p class="panelNote">{c.ownNote}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .root { padding: clamp(84px, 9vw, 148px) 20px; font-family: var(--font-text); }
  .container { max-width: 1250px; margin: 0 auto; width: 100%; }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(44px, 6vw, 96px);
    align-items: start;
  }
  .head { margin-bottom: 30px; }
  .intro, .outro { margin: 0; font-size: 15.5px; line-height: 1.72; color: #0B1A26ad; max-width: 50ch; }
  .outro {
    margin-top: 26px;
    padding-top: 26px;
    border-top: 1px solid #0B1A2617;
    color: var(--color-kit-black);
    font-weight: 600;
  }
  .panel {
    background: #ffffff;
    border: 1px solid #0B1A2612;
    border-radius: 8px;
    padding: clamp(28px, 3vw, 42px);
    box-shadow: 0 26px 54px -42px #1D3E5680;
  }
  .panelTitle {
    font-family: var(--font-head);
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 800;
    letter-spacing: -0.014em;
    line-height: 1.3;
    color: var(--color-kit-black);
    margin: 0 0 26px;
  }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 15px; }
  .panelNote {
    margin: 28px 0 0;
    padding-top: 20px;
    border-top: 1px solid #0B1A2612;
    font-size: 13px;
    line-height: 1.6;
    color: #0B1A268a;
  }
  .own {
    margin-top: 24px;
    padding: clamp(24px, 2.6vw, 34px);
    border-radius: 8px;
    border: 1px solid #0B1A2617;
    background: transparent;
  }
  .ownTitle {
    font-family: var(--font-head);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 20px;
    color: var(--accent);
    line-height: 24px;
  }
  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; gap: 44px; }
    .intro, .outro { max-width: none; }
  }
</style>
