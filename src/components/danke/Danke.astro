---
import { Image } from 'astro:assets';
import Title from '../ui/Title.astro';
import Text from '../ui/Text.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { danke as c } from '../../data/content/danke';
import { images } from '../../data/images';
import { site, telHref } from '../../data/site';
---
<section class="wrap full" style="background: var(--color-kit-light); --accent: var(--color-kit-key1);">
  <div class="container">
    <header class="top">
      <Image class="logo" src={images.logoDunkel.src} alt={images.logoDunkel.alt} height={40} widths={[160, 320, 480]} sizes="160px" loading="eager" />
    </header>

    <div class="split">
      <div class="photoCol" data-reveal data-reveal-load>
        <Image class="photo" src={images.simon.src} alt={images.simon.alt} width={260} height={325} widths={[230, 260, 390, 520]} sizes="(max-width: 860px) 230px, 260px" fit="cover" loading="eager" fetchpriority="high" />
        <div class="nameplate">
          <span class="pName">{site.person.name}</span>
          <span class="pRole">{site.person.role}</span>
        </div>
      </div>

      <div class="copy" data-reveal data-reveal-load style="--rdelay: 0.12s;">
        <span class="mark" aria-hidden="true"><Icon name="check" size={22} strokeWidth={2.8} /></span>
        <Badge variant="gold" dot>{c.badge}</Badge>
        <Title as="h1" size="lg" class="h1">{c.headline}</Title>
        <Text size="lg" tone="soft">{c.message1}</Text>
        <Text size="md" tone="muted">{c.message2}</Text>
      </div>
    </div>

    <div class="stepsBlock" data-reveal data-reveal-load style="--ry: 22px; --rdelay: 0.24s;">
      <h2 class="stepsTitle">{c.stepsTitle}</h2>
      <ol class="steps">
        {c.steps.map((s, i) => (
          <li class="step">
            <span class="stepNum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="stepTitle">{s.title}</h3>
            <span class="stepText">{s.text}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="note" data-reveal="fade" data-reveal-load style="--rdelay: 0.36s;">
      <span class="noteIcon" aria-hidden="true"><Icon name="phone" size={18} strokeWidth={2} /></span>
      <div class="noteBody">
        <p class="noteText">{c.noteText}</p>
        <div class="noteLinks">
          <a class="noteLink tap" href={telHref(site.contact.phone)}>{site.contact.phone}</a>
          <a class="noteLink tap" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </div>
      </div>
    </div>

    <p class="copyright">{site.copyright}</p>
  </div>
</section>

<style>
  .wrap { position: relative; overflow: hidden; padding: clamp(30px, 4vw, 48px) 0 clamp(40px, 5vw, 62px); font-family: var(--font-text); }
  .full { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; }
  .wrap::before {
    content: '';
    position: absolute;
    right: -8%; top: -22%;
    width: 720px; height: 720px;
    pointer-events: none;
    background: radial-gradient(circle at center, #C6A15B2b 0%, #C6A15B00 64%);
  }
  .container { position: relative; z-index: 1; width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
  .top { padding-bottom: clamp(26px, 3.5vw, 44px); border-bottom: 1px solid #1D3E5617; margin-bottom: clamp(30px, 4vw, 52px); }
  .top :global(.logo) { display: block; height: 40px; width: auto; }
  .split { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(26px, 4vw, 56px); align-items: center; }
  .photoCol { position: relative; }
  .photoCol :global(.photo) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 6px; filter: saturate(0.94); }
  .nameplate {
    position: relative;
    margin: -26px 0 0 18px;
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
    padding: 13px 18px;
    background: var(--color-kit-key2);
    border-left: 3px solid var(--accent, #C6A15B);
    border-radius: 3px;
    box-shadow: 0 18px 40px -26px #1D3E56cc;
  }
  .pName { font-family: var(--font-head); font-size: 16px; font-weight: 700; color: #ffffff; line-height: 1.2; }
  .pRole { font-size: 12px; color: #ffffff9e; line-height: 1.2; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px; height: 46px;
    border-radius: 999px;
    background: #C6A15B29;
    color: #7d611f;
    margin-bottom: 2px;
  }
  .copy :global(.h1) { max-width: 16em; }
  .stepsBlock { margin-top: clamp(40px, 5vw, 68px); padding-top: clamp(26px, 3vw, 38px); border-top: 1px solid #1D3E5617; }
  .stepsTitle {
    display: block;
    margin: 0 0 22px;
    font-family: var(--font-text);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a6c2f;
  }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); }
  .step { display: flex; flex-direction: column; gap: 8px; padding-top: 18px; border-top: 2px solid var(--accent, #C6A15B); }
  .stepNum { font-family: var(--font-head); font-size: 13px; font-weight: 800; letter-spacing: 0.08em; color: #1D3E564d; }
  .stepTitle { margin: 0; font-family: var(--font-head); font-size: clamp(16px, 1.8vw, 19px); font-weight: 700; letter-spacing: -0.012em; line-height: 1.3; color: var(--color-kit-black); }
  .stepText { font-size: 14.5px; line-height: 1.6; color: #1D3E56a6; }
  .note {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-top: clamp(34px, 4vw, 52px);
    padding: clamp(20px, 2.4vw, 28px);
    background: var(--color-kit-white);
    border: 1px solid #1D3E5614;
    border-left: 3px solid var(--accent, #C6A15B);
    border-radius: 4px;
  }
  .noteIcon { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 999px; flex-shrink: 0; background: #C6A15B24; color: #7d611f; }
  .noteBody { display: flex; flex-direction: column; gap: 10px; }
  .noteText { margin: 0; font-size: 15px; line-height: 1.6; color: #1D3E56cc; max-width: 44em; }
  .noteLinks { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .noteLink {
    font-family: var(--font-head);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-kit-key2);
    text-decoration: none;
    border-bottom: 1px solid #C6A15B80;
    padding-bottom: 2px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .noteLink:hover { color: #8a6c2f; border-color: var(--accent, #C6A15B); }
  .copyright { margin: clamp(30px, 4vw, 46px) 0 0; font-size: 12px; color: #1D3E5673; }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; gap: 28px; }
    .photoCol { max-width: 230px; }
    .steps { grid-template-columns: 1fr; gap: 22px; }
  }
  @media (max-width: 600px) { .note { flex-direction: column; gap: 14px; } }
</style>
