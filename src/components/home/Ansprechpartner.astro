---
import { Image } from 'astro:assets';
import Title from '../ui/Title.astro';
import Text from '../ui/Text.astro';
import Icon from '../ui/Icon.astro';
import { ansprechpartner as c } from '../../data/content/home';
import { images } from '../../data/images';
import { site, telHref } from '../../data/site';
---
<section class="wrap" style="background: var(--color-kit-light);">
  <div class="container">
    <div class="person">
      <div class="photoCol" data-reveal data-amount="0.3" style="--ry: 22px;">
        <Image class="photo" src={images.simon.src} alt={images.simon.alt} width={280} height={350} widths={[280, 420, 560]} sizes="(max-width: 860px) 260px, 280px" fit="cover" position="center" format="webp" />
        <div class="nameplate">
          <span class="pName">{site.person.name}</span>
          <span class="pRole">{site.person.role}</span>
        </div>
      </div>

      <div class="letter" data-reveal data-amount="0.25" style="--ry: 22px; --rdelay: 0.12s;">
        <span class="kicker">{c.kicker}</span>
        <p class="lead">{c.letter1}</p>
        <p class="leadSmall">{c.letter2}</p>
        <div class="contacts">
          <a class="contact tap" href={`mailto:${site.contact.personEmail}`}>
            <Icon name="mail" size={16} strokeWidth={2} />
            <span>{site.contact.personEmail}</span>
          </a>
          <a class="contact tap" href={telHref(site.contact.phone)}>
            <Icon name="phone" size={16} strokeWidth={2} />
            <span>{site.contact.phone}</span>
          </a>
        </div>
      </div>
    </div>

    <div class="qual" data-reveal data-amount="0.2">
      <div class="qualHead">
        <Title as="h2" size="md">{c.qualTitle}</Title>
        <Text size="md" tone="soft" class="qualIntro">{c.qualIntro}</Text>
      </div>
      <div class="qualGrid">
        <div class="col">
          <h3 class="colLabel colYes">{c.fitLabel}</h3>
          <ul class="qList">
            {c.fitItems.map((t) => (
              <li class="qItem"><span class="qMark markYes"><Icon name="check" size={13} strokeWidth={3} /></span><span>{t}</span></li>
            ))}
          </ul>
        </div>
        <div class="col">
          <h3 class="colLabel colNo">{c.noFitLabel}</h3>
          <ul class="qList">
            {c.noFitItems.map((t) => (
              <li class="qItem qItemMuted"><span class="qMark markNo"><Icon name="close" size={13} strokeWidth={3} /></span><span>{t}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .wrap { position: relative; padding: clamp(70px, 9vw, 120px) 0; font-family: var(--font-text); }
  .container { max-width: 1250px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
  .person { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: clamp(28px, 4vw, 62px); align-items: center; }
  .photoCol { position: relative; }
  .photoCol :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 6px;
    filter: saturate(0.94);
  }
  .nameplate {
    position: relative;
    margin: -26px 0 0 18px;
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
    padding: 13px 18px;
    background: var(--color-kit-key2);
    border-left: 3px solid var(--color-kit-key1);
    border-radius: 3px;
    box-shadow: 0 18px 40px -26px #1D3E56cc;
  }
  .pName { font-family: var(--font-head); font-size: 16px; font-weight: 700; color: #ffffff; line-height: 1.2; }
  .pRole { font-size: 12px; color: #ffffff9e; line-height: 1.2; }
  .letter { display: flex; flex-direction: column; gap: 16px; }
  .kicker { font-size: 11.5px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #8a6c2f; }
  .lead {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(19px, 2.3vw, 26px);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.014em;
    color: var(--color-kit-black);
    max-width: 24em;
    text-wrap: balance;
  }
  .leadSmall { margin: 0; font-size: clamp(15px, 1.6vw, 17px); line-height: 1.65; color: #1D3E56b8; max-width: 38em; }
  .contacts { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 4px; }
  .contact {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14.5px;
    color: var(--color-kit-key2);
    text-decoration: none;
    border-bottom: 1px solid #1D3E5633;
    padding-bottom: 2px;
    transition: border-color 0.18s ease, color 0.18s ease;
  }
  .contact:hover { color: #8a6c2f; border-color: var(--color-kit-key1); }
  .qual { margin-top: clamp(48px, 6vw, 86px); padding-top: clamp(34px, 4vw, 52px); border-top: 1px solid #1D3E561f; }
  .qualHead { display: flex; flex-direction: column; gap: 10px; margin-bottom: clamp(26px, 3vw, 40px); max-width: 44em; }
  .qualHead :global(.qualIntro) { max-width: 40em; }
  .qualGrid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 3.5vw, 56px); }
  .col { display: flex; flex-direction: column; gap: 16px; }
  .colLabel {
    margin: 0;
    font-family: var(--font-text);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    padding-bottom: 12px;
    border-bottom: 2px solid;
  }
  .colYes { color: #6f5522; border-color: var(--color-kit-key1); }
  .colNo { color: #1D3E5680; border-color: #1D3E5626; }
  .qList { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 13px; }
  .qItem { display: flex; align-items: flex-start; gap: 11px; font-size: 15.5px; line-height: 1.55; color: var(--color-kit-black); }
  .qItemMuted { color: #1D3E5699; }
  .qMark { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 999px; flex-shrink: 0; margin-top: 1px; }
  .markYes { background: #C6A15B2e; color: #7d611f; }
  .markNo { background: #1D3E5614; color: #1D3E5680; }
  @media (max-width: 860px) {
    .person { grid-template-columns: 1fr; gap: 30px; }
    .photoCol { max-width: 260px; }
    .qualGrid { grid-template-columns: 1fr; gap: 30px; }
  }
</style>
