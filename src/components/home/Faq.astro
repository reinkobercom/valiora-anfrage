---
import Title from '../ui/Title.astro';
import Text from '../ui/Text.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { faq as c } from '../../data/content/home';
---
<section class="wrap" style="background: var(--color-kit-white);">
  <div class="container">
    <div class="split">
      <div class="left" data-reveal data-amount="0.3" style="--ry: 22px;">
        <span class="kicker">{c.kicker}</span>
        <Title as="h2" size="lg" class="h2">{c.headline}</Title>
        <Text size="md" tone="soft" class="note">{c.note}</Text>
        <div class="ctaBox">
          <Button href="#region-check" variant="navy" size="md" icon="arrowRight">{c.ctaLabel}</Button>
          <span class="ctaNote">{c.ctaNote}</span>
        </div>
      </div>

      <div class="right" data-reveal data-amount="0.15" style="--ry: 22px; --rdelay: 0.1s;">
        {c.items.map((it, i) => (
          <details class="item" name="faq" open={i === 0}>
            <summary class="head">
              <h3 class="q">{it.question}</h3>
              <span class="sign" aria-hidden="true">
                <span class="i-plus"><Icon name="plus" size={17} strokeWidth={2.4} /></span>
                <span class="i-minus"><Icon name="minus" size={17} strokeWidth={2.4} /></span>
              </span>
            </summary>
            <div class="panel"><p class="a">{it.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Nur ein Eintrag gleichzeitig offen – auch in Browsern ohne <details name>
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[name="faq"]'));
  items.forEach((d) => d.addEventListener('toggle', () => {
    if (d.open) items.forEach((o) => { if (o !== d) o.open = false; });
  }));
</script>

<style>
  .wrap { position: relative; padding: clamp(70px, 9vw, 122px) 0; font-family: var(--font-text); }
  .container { max-width: 1250px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
  .split { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); gap: clamp(34px, 5vw, 82px); align-items: start; }
  .left { display: flex; flex-direction: column; gap: 14px; position: sticky; top: 40px; }
  .kicker { font-size: 11.5px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #8a6c2f; }
  .left :global(.h2) { max-width: 12em; }
  .left :global(.note) { max-width: 28em; }
  .ctaBox { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: 14px; }
  .ctaNote { font-size: 12.5px; color: #1D3E5699; }
  .right { border-top: 1px solid #1D3E561f; }

  /* @siteui/accordion-item */
  .item { border-bottom: 1px solid #1D3E561f; font-family: var(--font-text); }
  .head {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    text-align: left;
  }
  .head::-webkit-details-marker { display: none; }
  .head:focus-visible { outline: 2px solid var(--color-kit-key1); outline-offset: 3px; }
  .q {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(16px, 1.7vw, 18px);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-kit-black);
  }
  .sign {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    flex-shrink: 0;
    background: #C6A15B24;
    color: #8a6c2f;
    transition: background-color 0.18s ease;
  }
  .i-minus { display: none; }
  .item[open] .i-minus { display: block; }
  .item[open] .i-plus { display: none; }
  .item[open] .sign { background: var(--color-kit-key1); color: var(--color-kit-black); }
  .panel { padding: 0 54px 22px 0; }
  .a { margin: 0; font-size: 15.5px; line-height: 1.62; color: #1D3E56cc; }
  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; gap: 34px; }
    .left { position: static; }
  }
</style>
