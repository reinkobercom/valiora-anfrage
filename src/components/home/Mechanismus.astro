---
import Title from '../ui/Title.astro';
import Text from '../ui/Text.astro';
import Button from '../ui/Button.astro';
import { mechanismus as c } from '../../data/content/home';
---
<section class="wrap" style="background: var(--color-kit-white); --accent: var(--color-kit-key1);">
  <div class="container">
    <div class="split">
      <div class="left" data-reveal data-amount="0.25">
        <span class="kicker">{c.kicker}</span>
        <Title as="h2" size="lg" class="h2">{c.headline}</Title>
        <Text size="lg" tone="soft">{c.body}</Text>
        <Text size="lg" tone="soft">{c.body2}</Text>
        <div class="ctaBox">
          <Button href="#region-check" variant="gold" size="lg" icon="arrowRight">{c.ctaLabel}</Button>
          <span class="ctaNote">{c.ctaNote}</span>
        </div>
      </div>

      <div class="right">
        <h3 class="servicesTitle" data-reveal data-amount="0.4" style="--ry: 20px; --rdur: 0.55s;">{c.servicesTitle}</h3>
        <div class="groups">
          {c.groups.map((g, i) => (
            <div class="group" data-reveal data-amount="0.5" style={`--ry: 18px; --rdur: 0.5s; --rdelay: ${i * 0.08}s;`}>
              <span class="groupLabel">{g.label}</span>
              <ul class="tags">
                {g.entries.map((e) => <li class="tag">{e}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="servicesNote">{c.servicesNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .wrap { position: relative; padding: clamp(70px, 9vw, 126px) 0; font-family: var(--font-text); }
  .container { max-width: 1250px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    gap: clamp(36px, 5vw, 84px);
    align-items: start;
  }
  .left { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 40px; }
  .kicker { font-size: 11.5px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #8a6c2f; }
  .left :global(.h2) { max-width: 13em; }
  .ctaBox { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: 12px; }
  .ctaNote { font-size: 12.5px; color: #1D3E5699; }
  .right { padding-left: clamp(0px, 2vw, 28px); border-left: 1px solid #1D3E5617; }
  .servicesTitle {
    margin: 0 0 26px;
    font-family: var(--font-head);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.28;
    color: var(--color-kit-black);
    padding-left: clamp(0px, 2vw, 24px);
  }
  .groups { display: flex; flex-direction: column; }
  .group {
    padding: 20px 0 20px clamp(0px, 2vw, 24px);
    border-top: 1px solid #1D3E5614;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .group:last-child { border-bottom: 1px solid #1D3E5614; }
  .groupLabel { font-size: 11.5px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: var(--color-kit-key2); }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .tag {
    display: inline-block;
    padding: 7px 12px;
    border-radius: 3px;
    font-size: 13.5px;
    line-height: 1.2;
    color: #1D3E56d9;
    background: var(--color-kit-light);
    border: 1px solid #1D3E560f;
  }
  .servicesNote {
    margin: 22px 0 0;
    padding-left: clamp(0px, 2vw, 24px);
    font-size: 14.5px;
    line-height: 1.6;
    color: #1D3E56a6;
    max-width: 34em;
  }
  @media (max-width: 940px) {
    .split { grid-template-columns: 1fr; gap: 40px; }
    .left { position: static; }
    .right { border-left: none; padding-left: 0; }
    .servicesTitle, .group, .servicesNote { padding-left: 0; }
  }
</style>
