---
import { Image } from 'astro:assets';
import Title from '../ui/Title.astro';
import Text from '../ui/Text.astro';
import Button from '../ui/Button.astro';
import { abschluss as c } from '../../data/content/home';
import { images } from '../../data/images';
import { site, telHref } from '../../data/site';
---
<section class="wrap" style="background: var(--color-kit-black); --accent: var(--color-kit-key1);">
  <div class="glow" aria-hidden="true"></div>
  <div class="container">
    <div class="band" data-reveal data-amount="0.25" style="--ry: 26px; --rdur: 0.65s;">
      <span class="corner" aria-hidden="true"></span>
      <span class="eyebrow">{c.eyebrow}</span>
      <Title as="h2" size="xl" color="var(--color-kit-white)" class="h2">{c.headline}</Title>
      <Text size="lg" color="#ffffffb3" class="sub">{c.subline}</Text>
      <div class="ctaBox">
        <Button href="#region-check" variant="gold" size="lg" icon="arrowRight">{c.ctaLabel}</Button>
        <span class="ctaNote">{c.ctaNote}</span>
      </div>
    </div>

    <footer class="footer">
      <div class="fBrand">
        <Image class="fLogo" src={images.logoHell.src} alt={images.logoHell.alt} height={34} widths={[136, 272, 408]} sizes="136px" />
      </div>
      <div class="fContact">
        <a class="fLink tap" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a class="fLink tap" href={telHref(site.contact.phone)}>{site.contact.phone}</a>
      </div>
      <nav class="fLegal" aria-label="Rechtliches">
        <a class="fLink tap" href={site.legal.impressum}>Impressum</a>
        <a class="fLink tap" href={site.legal.datenschutz}>Datenschutz</a>
      </nav>
    </footer>
    <p class="copy">{site.copyright}<span class="sep" aria-hidden="true"> · </span><a class="copyLink tap" href="#cookie-einstellungen" data-cookie-settings>Cookie-Einstellungen</a></p>
  </div>
</section>

<style>
  .wrap { position: relative; overflow: hidden; padding: clamp(66px, 8.5vw, 116px) 0 clamp(34px, 4vw, 50px); font-family: var(--font-text); }
  .glow {
    position: absolute;
    left: 50%; top: -14%;
    width: 1000px; height: 620px;
    transform: translateX(-50%);
    pointer-events: none;
    background: radial-gradient(closest-side, #C6A15B29 0%, #C6A15B00 100%);
  }
  .container { position: relative; z-index: 1; max-width: 1250px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
  .band {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(34px, 4.5vw, 62px);
    background: #ffffff08;
    border: 1px solid #ffffff1f;
    border-radius: 6px;
    overflow: hidden;
  }
  .corner {
    position: absolute;
    left: 0; top: 0;
    width: 4px; height: 100%;
    background: linear-gradient(180deg, var(--accent, #C6A15B) 0%, #C6A15B00 82%);
  }
  .eyebrow { font-size: 11.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent, #C6A15B); }
  .band :global(.h2) { max-width: 13em; }
  .band :global(.sub) { max-width: 38em; }
  .ctaBox { display: flex; flex-direction: column; align-items: flex-start; gap: 11px; margin-top: 12px; }
  .ctaNote { font-size: 12.5px; color: #ffffff8f; }
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 22px 34px;
    margin-top: clamp(48px, 6vw, 78px);
    padding-top: clamp(24px, 3vw, 34px);
    border-top: 1px solid #ffffff17;
  }
  .fBrand { display: inline-flex; align-items: center; }
  .fBrand :global(.fLogo) { display: block; height: 34px; width: auto; }
  .fContact, .fLegal { display: flex; flex-wrap: wrap; gap: 10px 24px; }
  .fLink {
    font-size: 13.5px;
    color: #ffffffa6;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .fLink:hover { color: #ffffff; border-color: var(--accent, #C6A15B); }
  .copy { margin: 26px 0 0; font-size: 12px; color: #ffffff59; letter-spacing: 0.02em; }
  .copyLink { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; transition: color 0.18s ease, border-color 0.18s ease; }
  .copyLink:hover { color: #ffffffa6; border-color: var(--accent, #C6A15B); }
  @media (max-width: 700px) {
    .footer { flex-direction: column; align-items: flex-start; gap: 18px; }
  }
</style>
