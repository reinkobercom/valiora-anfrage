---
import Title from '../ui/Title.astro';
import Text from '../ui/Text.astro';
import Badge from '../ui/Badge.astro';
import { beweis as c } from '../../data/content/home';
const track = [...c.voices, ...c.voices];
---
<section class="wrap" style={`background: var(--color-kit-light); --speed: ${c.marqueeSeconds}s;`}>
  <div class="container">
    <div class="split">
      <div class="panel" data-reveal data-amount="0.3" style="background: var(--color-kit-key2);">
        <span class="panelEyebrow">{c.highlightEyebrow}</span>
        <span class="big">{c.statValue}</span>
        <span class="bigLabel">{c.statLabel}</span>
        <span class="panelRule" aria-hidden="true"></span>
        <span class="panelSource">{c.statSource}</span>
      </div>
      <div class="copy" data-reveal data-amount="0.25" style="--rdelay: 0.12s;">
        <Badge variant="outline">{c.kicker}</Badge>
        <Title as="h2" size="lg" class="h2">{c.headline}</Title>
        <Text size="lg" tone="soft">{c.body}</Text>
        <Text size="lg" tone="soft">{c.body2}</Text>
      </div>
    </div>
  </div>

  <div class="voicesBlock">
    <div class="container">
      <h3 class="voicesLabel">{c.voicesLabel}</h3>
    </div>
    <div class="marquee">
      <ul class="track">
        {track.map((v, i) => (
          <li class="chip" aria-hidden={i >= c.voices.length ? 'true' : undefined}>
            <span class="chipText">{v.text}</span>
            <span class="chipSource">{v.source}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .wrap {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 8vw, 112px) 0 clamp(44px, 5vw, 68px);
    font-family: var(--font-text);
  }
  .container { max-width: 1250px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(28px, 4vw, 60px);
    align-items: center;
  }
  .panel {
    position: relative;
    padding: clamp(30px, 3.4vw, 46px);
    border-radius: 6px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 6px;
    overflow: hidden;
    box-shadow: 0 34px 70px -44px #1D3E56cc;
  }
  .panel::after {
    content: '';
    position: absolute;
    right: -70px; top: -70px;
    width: 240px; height: 240px;
    background: radial-gradient(circle at center, #C6A15B4d 0%, #C6A15B00 68%);
    pointer-events: none;
  }
  .panelEyebrow { font-size: 11.5px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: var(--color-kit-key1); }
  .big {
    font-family: var(--font-head);
    font-size: clamp(78px, 11vw, 132px);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.05em;
    margin-top: 12px;
  }
  .bigLabel { font-size: clamp(16px, 1.7vw, 19px); line-height: 1.35; color: #ffffffd9; margin-top: 10px; max-width: 15em; }
  .panelRule { display: block; width: 40px; height: 2px; background: var(--color-kit-key1); margin: 20px 0 12px; }
  .panelSource { font-size: 13px; color: #ffffff9e; letter-spacing: 0.02em; }
  .copy { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .copy :global(.h2) { max-width: 16em; margin-top: 2px; }
  .voicesBlock {
    margin-top: clamp(46px, 6vw, 78px);
    padding-top: clamp(26px, 3vw, 38px);
    border-top: 1px solid #1D3E561f;
  }
  .voicesLabel {
    display: block;
    margin: 0 0 22px;
    font-family: var(--font-text);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1D3E5680;
  }
  .marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, #00000000 0%, #000000 9%, #000000 91%, #00000000 100%);
    mask-image: linear-gradient(90deg, #00000000 0%, #000000 9%, #000000 91%, #00000000 100%);
  }
  .track {
    display: flex;
    gap: 14px;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: slide var(--speed, 55s) linear infinite;
  }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes slide {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  .chip {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 18px 24px;
    background: var(--color-kit-white);
    border: 1px solid #1D3E5614;
    border-left: 3px solid var(--color-kit-key1);
    border-radius: 4px;
    white-space: nowrap;
  }
  .chipText { font-family: var(--font-head); font-size: 16px; font-weight: 700; letter-spacing: -0.01em; color: var(--color-kit-black); }
  .chipSource { font-size: 12.5px; color: #1D3E5699; }
  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; gap: 30px; }
    .panel { order: 2; }
    .copy { order: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
</style>
