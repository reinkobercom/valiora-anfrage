---
import CheckItem from '../ui/CheckItem.astro';
import { angebot as c } from '../../data/content/karriere';
---
<section class="sec" style="background: var(--color-kit-light);">
  <div class="container">
    <div class="left" data-reveal data-amount="0.3" style="--ry: 22px; --rdur: 0.5s;">
      <p class="kicker">{c.kicker}</p>
      <h2 class="title">{c.title}<span class="accent">{c.titleAccent}</span>{c.titleEnd}</h2>
      <p class="intro">{c.intro}</p>
      <p class="para">{c.para1}</p>
      <p class="para">{c.para2}</p>
    </div>

    <div data-reveal data-amount="0.3" style="--ry: 22px; --rdur: 0.5s; --rdelay: 0.1s;">
      <div class="card">
        <h3 class="cardTitle">{c.cardTitle}</h3>
        <ul class="list">
          {c.items.map((it) => <CheckItem tone="plain" size="sm">{it}</CheckItem>)}
        </ul>
        <p class="note">{c.cardNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .sec { width: 100%; padding: clamp(72px, 8vw, 120px) 24px; font-family: var(--font-text); }
  .container {
    max-width: 1250px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    gap: clamp(38px, 5vw, 82px);
    align-items: start;
  }
  .left { max-width: 60ch; }
  .kicker {
    font-family: var(--font-head);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 18px;
    color: var(--color-kit-key1);
  }
  .title {
    font-family: var(--font-head);
    font-size: clamp(27px, 3.6vw, 44px);
    font-weight: 800;
    line-height: 1.13;
    letter-spacing: -0.022em;
    margin: 0;
    color: var(--color-kit-black);
    text-wrap: balance;
  }
  .accent { color: var(--color-kit-key1); }
  .intro { margin: 24px 0 0; font-size: clamp(16.5px, 1.6vw, 18.5px); line-height: 1.6; color: var(--color-kit-black); font-weight: 500; }
  .para { margin: 20px 0 0; font-size: 16px; line-height: 1.7; color: #0B1A26ab; }
  /* @siteui/card tone="white" pad="lg" */
  .card {
    position: relative;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(28px, 3.2vw, 44px);
    background: var(--color-kit-white);
    border: 1px solid #1D3E5614;
    box-shadow: 0 20px 44px -34px #1D3E5666;
  }
  .cardTitle {
    font-family: var(--font-head);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.012em;
    margin: 0 0 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid #1D3E5614;
    color: var(--color-kit-black);
  }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .note { margin: 24px 0 0; padding-top: 20px; border-top: 1px solid #1D3E5614; font-size: 14px; line-height: 1.6; color: #1D3E56b8; }
  @media (max-width: 980px) {
    .sec { padding: 64px 20px; }
    .container { grid-template-columns: minmax(0, 1fr); gap: 34px; }
  }
</style>
