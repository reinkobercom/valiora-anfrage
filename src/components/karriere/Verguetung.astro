---
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { verguetung as c } from '../../data/content/karriere';
---
<section class="sec" style="background: var(--color-kit-light);">
  <div class="container">
    <SectionHead kicker={c.kicker} title={c.title} accent={c.titleAccent} titleEnd={c.titleEnd} subline={c.subline} align="center" tone="dark" />

    <div class="cols">
      {c.items.map((it, i) => (
        <div class="col" data-reveal data-amount="0.35" style={`--ry: 18px; --rdur: 0.45s; --rdelay: ${(i * 0.09).toFixed(2)}s;`}>
          <span class="rule" aria-hidden="true"></span>
          <h3 class="colTitle">{it.title}</h3>
          <p class="colText">{it.text}</p>
        </div>
      ))}
    </div>

    <div class="footer">
      <p class="note">{c.note}</p>
      <Button href={c.ctaHref} variant="gold" size="md" icon="arrowRight">{c.ctaLabel}</Button>
    </div>
  </div>
</section>

<style>
  .sec { width: 100%; padding: clamp(72px, 8vw, 120px) 24px; font-family: var(--font-text); }
  .container { max-width: 1060px; margin: 0 auto; }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(26px, 3.4vw, 52px); margin-top: clamp(42px, 4.6vw, 64px); }
  .col { padding-top: 22px; }
  .rule { display: block; width: 40px; height: 2px; margin-bottom: 20px; background: var(--color-kit-key1); }
  .colTitle {
    font-family: var(--font-head);
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 0 0 12px;
    color: var(--color-kit-black);
  }
  .colText { margin: 0; font-size: 15px; line-height: 1.65; color: #0B1A26ab; }
  .footer {
    margin-top: clamp(42px, 4.6vw, 62px);
    padding-top: 30px;
    border-top: 1px solid #1D3E561f;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
  }
  .note { margin: 0; font-size: 14.5px; line-height: 1.6; color: #1D3E56bf; max-width: 62ch; }
  @media (max-width: 860px) {
    .sec { padding: 64px 20px; }
    .cols { grid-template-columns: minmax(0, 1fr); gap: 30px; }
    .col { padding-top: 0; }
  }
</style>
