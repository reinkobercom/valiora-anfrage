---
import { Image } from 'astro:assets';
import Badge from '../ui/Badge.astro';
import Title from '../ui/Title.astro';
import Text from '../ui/Text.astro';
import Button from '../ui/Button.astro';
import CheckItem from '../ui/CheckItem.astro';
import Icon from '../ui/Icon.astro';
import RoleChip from '../ui/RoleChip.astro';
import { hero as c } from '../../data/content/karriere';
import { images } from '../../data/images';

const d = (i: number) => `--ry: 20px; --rdelay: ${(0.04 + i * 0.08).toFixed(2)}s;`;
---
<section class="hero" style="background: var(--color-kit-light); --accent: var(--color-kit-key1);">
  <div class="container">
    <div class="brand">
      <Image class="logo" src={images.logoDunkel.src} alt={images.logoDunkel.alt} width={168} widths={[168, 336, 504]} sizes="168px" loading="eager" fetchpriority="high" />
    </div>

    <div class="layout">
      <div class="left">
        <div class="badgeRow" data-reveal data-reveal-load style={d(0)}>
          <Badge variant="gold" dot>{c.badge}</Badge>
        </div>

        <div data-reveal data-reveal-load style={d(1)}>
          <Title as="h1" size="xl">
            {c.headlinePre}<span class="accentWord">{c.headlineAccent}</span>{c.headlinePost}
          </Title>
        </div>

        <div data-reveal data-reveal-load style={d(2)}>
          <Text size="lg" class="subline">{c.subline}</Text>
        </div>

        <div class="factsWrap" data-reveal data-reveal-load style={d(3)}>
          <p class="eyebrow">{c.factsEyebrow}</p>
          <ul class="facts">
            {c.facts.map((f) => <CheckItem tone="plain" size="sm" icon={f.icon}>{f.label}</CheckItem>)}
          </ul>
        </div>

        <div class="ctaWrap" data-reveal data-reveal-load style={d(4)}>
          <Button href={c.ctaHref} variant="gold" size="lg" icon="arrowRight">{c.ctaLabel}</Button>
          <span class="ctaNote">{c.ctaNote}</span>
        </div>

        <div class="rolesWrap" data-reveal data-reveal-load style={d(5)}>
          <span class="rolesIntro">{c.rolesIntro}</span>
          <div class="roles">
            {c.roles.map((r) => <RoleChip name={r.name} tag={r.tag} href={r.href} icon={r.icon} tone="dark" size="sm" />)}
          </div>
        </div>
      </div>

      <div class="right" data-reveal data-reveal-load style={d(6)}>
        <div class="videoFrame">
          {c.videoUrl ? (
            <iframe
              class="videoEmbed"
              src={c.videoUrl}
              title={c.videoLabel}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          ) : (
            <div class="videoPlaceholder">
              <span class="play" aria-hidden="true"><Icon name="play" size={20} filled /></span>
              <span class="videoLabel">{c.videoLabel}</span>
              <span class="videoNote">{c.videoNote}</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    padding: 40px 24px 104px;
    font-family: var(--font-text);
  }
  .container { max-width: 1250px; margin: 0 auto; }
  .brand { display: block; margin: 0 0 56px; width: 168px; }
  .brand :global(.logo) { display: block; width: 100%; height: auto; }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }
  .left { display: flex; flex-direction: column; align-items: flex-start; }
  .badgeRow { margin-bottom: 24px; }
  .accentWord { color: var(--accent); }
  .left :global(.subline) { color: #0B1A26b3; max-width: 54ch; margin-top: 22px; }
  .factsWrap { margin-top: 34px; padding-top: 26px; border-top: 1px solid #1D3E561f; width: 100%; }
  .eyebrow {
    font-family: var(--font-head);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 16px;
    color: var(--accent);
  }
  .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .ctaWrap { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; margin-top: 36px; }
  .ctaNote { font-size: 13px; color: #0B1A2685; }
  .rolesWrap { margin-top: 40px; width: 100%; }
  .rolesIntro { display: block; font-size: 13px; color: #0B1A2685; margin-bottom: 12px; }
  .roles { display: flex; flex-wrap: wrap; gap: 10px; }
  .right { width: 100%; }
  .videoFrame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-kit-white);
    border: 1px solid #1D3E561f;
    box-shadow: 0 34px 70px -46px #1D3E5680;
  }
  .videoEmbed { width: 100%; height: 100%; border: 0; display: block; }
  .videoPlaceholder {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    text-align: center;
    padding: 28px;
  }
  .play {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border-radius: 999px;
    padding-left: 4px;
    background: var(--accent);
    color: #0B1A26;
    box-shadow: 0 0 0 9px #C6A15B24;
  }
  .videoLabel {
    position: relative;
    font-family: var(--font-head);
    font-size: 15px;
    font-weight: 700;
    line-height: 24px;
    color: var(--color-kit-black);
    letter-spacing: -0.01em;
    max-width: 26ch;
  }
  .videoNote {
    position: relative;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0B1A267a;
  }
  @media (max-width: 940px) {
    .hero { padding: 32px 20px 76px; }
    .brand { margin-bottom: 38px; }
    .layout { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .videoFrame { aspect-ratio: 16 / 9; }
  }
</style>
