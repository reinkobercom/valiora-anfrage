---
import SectionHead from '../ui/SectionHead.astro';
import CheckItem from '../ui/CheckItem.astro';
import Icon from '../ui/Icon.astro';
import { rollen as c } from '../../data/content/karriere';
---
<section class="sec" id={c.anchorId} style="background: var(--color-kit-white);">
  <div class="container">
    <SectionHead kicker={c.kicker} title={c.title} accent={c.titleAccent} titleEnd={c.titleEnd} subline={c.subline} align="left" tone="dark" />

    <div class="grid">
      {c.items.map((role, i) => (
        <div data-reveal data-amount="0.25" style={`--ry: 22px; --rdur: 0.45s; --rdelay: ${(i * 0.08).toFixed(2)}s;`}>
          <div class="card">
            <span class="mark"><Icon name={role.icon} size={21} strokeWidth={2} /></span>
            <span class="tag">{role.tag}</span>
            <h3 class="name">{role.name}</h3>
            <p class="intro">{role.intro}</p>

            <p class="blockLabel">{c.tasksLabel}</p>
            <ul class="tasks">
              {role.tasks.map((t) => <CheckItem tone="plain" size="sm">{t}</CheckItem>)}
            </ul>

            <div class="fitRow">
              <p class="fit"><span class="fitLead">{c.fitLabel}</span>{' '}{role.fit}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sec { position: relative; width: 100%; padding: clamp(72px, 8vw, 120px) 24px; font-family: var(--font-text); }
  .container { max-width: 1250px; margin: 0 auto; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: clamp(38px, 4vw, 56px); }
  /* @siteui/card tone="white" pad="lg" */
  .card {
    position: relative;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 0;
    height: 100%;
    padding: clamp(28px, 3.2vw, 44px);
    background: var(--color-kit-white);
    border: 1px solid #1D3E5614;
    box-shadow: 0 20px 44px -34px #1D3E5666;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: #C6A15B24;
    color: #8a6c2f;
    margin-bottom: 20px;
  }
  .tag { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 8px; color: var(--color-kit-key1); }
  .name {
    font-family: var(--font-head);
    font-size: clamp(21px, 2.2vw, 25px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 12px;
    color: var(--color-kit-black);
  }
  .intro { margin: 0; font-size: 15px; line-height: 1.62; color: #0B1A26ab; }
  .blockLabel {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1D3E5699;
    margin: 26px 0 14px;
    padding-top: 22px;
    border-top: 1px solid #1D3E5614;
  }
  .tasks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .fitRow { margin-top: auto; padding-top: 22px; }
  .fit { margin: 0; font-size: 14px; line-height: 1.55; color: #1D3E56c9; }
  .fitLead { font-weight: 700; color: var(--color-kit-black); }
  @media (max-width: 980px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .sec { padding: 64px 20px; }
  }
</style>
