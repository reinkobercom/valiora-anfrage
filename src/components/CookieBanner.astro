---
/**
 * Cookie-Hinweis: Der Meta-Pixel lädt erst nach Klick auf „Alle akzeptieren“.
 * Die Entscheidung wird im Browser gespeichert (localStorage) und kann über jeden Link
 * mit dem Attribut data-cookie-settings (z. B. „Cookie-Einstellungen“ im Footer) geändert werden.
 */
import { site } from '../data/site';
---
<div class="cc" id="cookie-consent" role="dialog" aria-modal="false" aria-labelledby="cc-title" aria-describedby="cc-text" hidden>
  <div class="cc-card">
    <p class="cc-title" id="cc-title">Wir verwenden Cookies</p>
    <p class="cc-text" id="cc-text">
      Technisch notwendige Funktionen laufen immer. Mit Ihrer Zustimmung setzen wir zusätzlich den Meta-Pixel ein, um unsere
      Werbung zu messen. Sie können Ihre Entscheidung jederzeit über „Cookie-Einstellungen“ im Seitenfuß ändern. Mehr in der{' '}
      <a href={site.legal.datenschutz}>Datenschutzerklärung</a>.
    </p>
    <div class="cc-actions">
      <button type="button" class="cc-btn cc-btn-sec" data-consent="necessary">Nur notwendige</button>
      <button type="button" class="cc-btn cc-btn-pri" data-consent="all">Alle akzeptieren</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ pixelId: site.tracking.metaPixelId }}>
  (function () {
    var KEY = 'valiora-consent-v1';
    var box = document.getElementById('cookie-consent');
    function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function write(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
    function loadPixel() {
      if (!pixelId || window.fbq) return;
      !function (f, b, e, v, n, t, s) {
        if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
        if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
        t = b.createElement(e); t.async = !0; t.src = v; s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
      }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      window.fbq('init', pixelId);
      window.fbq('track', 'PageView');
    }
    function show() { box.hidden = false; }
    function hide() { box.hidden = true; }
    var state = read();
    if (state === 'all') loadPixel();
    else if (state !== 'necessary') show();
    box.addEventListener('click', function (ev) {
      var btn = ev.target.closest('[data-consent]');
      if (!btn) return;
      var v = btn.getAttribute('data-consent');
      var before = read();
      write(v); hide();
      if (v === 'all') loadPixel();
      else if (before === 'all') location.reload(); // Widerruf: Pixel sofort entladen
    });
    document.addEventListener('click', function (ev) {
      var link = ev.target.closest('[data-cookie-settings]');
      if (!link) return;
      ev.preventDefault(); show();
      var first = box.querySelector('button'); if (first) first.focus();
    });
  })();
</script>

<style>
  .cc {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 900;
    display: flex;
    justify-content: center;
    padding: 16px;
    pointer-events: none;
  }
  .cc[hidden] { display: none; }
  .cc-card {
    pointer-events: auto;
    width: 100%;
    max-width: 640px;
    background: var(--color-kit-white);
    border-radius: 6px;
    border-top: 4px solid var(--color-kit-key1);
    box-shadow: 0 30px 70px -30px #0B1A26a6, 0 0 0 1px #1D3E5614;
    padding: 22px 24px;
    font-family: var(--font-text);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cc-title {
    font-family: var(--font-head);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-kit-black);
  }
  .cc-text {
    font-size: 14px;
    line-height: 1.55;
    color: #1D3E56cc;
  }
  .cc-text a { color: var(--gold-dark); text-decoration: underline; text-underline-offset: 2px; }
  .cc-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .cc-btn {
    flex: 1 1 180px;
    min-height: 46px;
    padding: 11px 18px;
    border-radius: 4px;
    font-family: var(--font-text);
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }
  .cc-btn-pri { background: var(--color-kit-key1); color: var(--color-kit-black); border: 1px solid var(--color-kit-key1); }
  .cc-btn-pri:hover { background: #d8b374; }
  .cc-btn-sec { background: transparent; color: var(--color-kit-key2); border: 1px solid #1D3E5640; }
  .cc-btn-sec:hover { border-color: var(--color-kit-key2); background: #1D3E560a; }
</style>
